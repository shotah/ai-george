# MCP server manifest — listed = granted (the process may start).
# `george init` writes this to ~/.config/george/mcp.toml (MCP_MANIFEST overrides).
#
# Tool names reach the model as {tools_prefix or name}__{tool}.
# `args` and `env` expand ${VAR} before the child starts; george sets
# GEORGE_ROOT to the git toplevel of the cwd (export it to pick another tree).
#
# Prefix enable (default on): a server's schemas stay off the request until
# the agent calls mcp_enable, except servers marked `force = true`.
#   dynamic_tools = false   # publish every server every turn (small models / rollback)
#   force = true            # on a [[server]]; or MCP_ENABLE_FORCE=fs,git
#
# Optional publishing filters (host-side, after tools/list; the child still starts):
#   tools   = ["file_get", "file_patch"]   # allowlist (omit = all)
#   exclude = ["raw_*"]                    # denylist (shell-style * ?)
#   tools_prefix = "f"                     # override the {prefix} in {prefix}__{tool}
#
# Optional call budget — a vendor quota, counted in george.db at the human's midnight.
# Over it the tool returns a refusal that names the reset.
#   budget = "50/month"     # or "1/day"
#
# Optional download, for `george tools-fetch` and `george tools-plan`:
#   download_tag = "v0.0.4"   # or "latest" (resolved through the GitHub API)
#   download_url = "https://github.com/org/repo/releases/download/{tag}/tool_{version}_{os}_{arch}.tar.gz"
#   Placeholders: {os} {arch} {tag} {version} ({version} = tag without a leading v).
#
# Any MCP stdio server works. Add one the same way:
#
# [[server]]
# name    = "example"
# command = "example-mcp"
# args    = ["--flag", "value"]

# --- Coding agent -------------------------------------------------------------
# --root is the jail for fs and git. shell sets the cwd and is not a jail.
# github-mcp reads GITHUB_TOKEN or GH_TOKEN from the process env and is
# skipped at boot when both are empty; the other three stay up.

[[server]]
name    = "fs"
command = "fs-mcp"
args    = ["--root", "${GEORGE_ROOT}", "--tool-tier", "core"]
force   = true
download_tag = "latest"
download_url = "https://github.com/shotah/fs-mcp/releases/download/{tag}/fs-mcp_{version}_{os}_{arch}.tar.gz"

[[server]]
name    = "git"
command = "git-mcp"
args    = ["--root", "${GEORGE_ROOT}", "--tool-tier", "core"]
force   = true
download_tag = "latest"
download_url = "https://github.com/shotah/git-mcp/releases/download/{tag}/git-mcp_{version}_{os}_{arch}.tar.gz"

[[server]]
name    = "shell"
command = "shell-mcp"
args    = ["--root", "${GEORGE_ROOT}"]
force   = true
download_tag = "latest"
download_url = "https://github.com/shotah/shell-mcp/releases/download/{tag}/shell-mcp_{version}_{os}_{arch}.tar.gz"

[[server]]
name    = "github"
command = "github-mcp"
force   = true
download_tag = "latest"
download_url = "https://github.com/shotah/github-mcp/releases/download/{tag}/github-mcp_{version}_{os}_{arch}.tar.gz"

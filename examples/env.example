# Required — OpenAI-compatible endpoint (Ollama, Gemini, xAI, …)
# Local eval model: Qwen3-Coder-30B-A3B at Q4_K_M.
#   ollama pull qwen3-coder:30b-a3b-q4_K_M
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3-coder:30b-a3b-q4_K_M
# LLM_MAX_TOKENS=4096             # completion cap (0 = provider default)
LLM_REASONING_EFFORT=none         # Ollama/Qwen: none so max tokens aren't eaten by CoT

# Gemini — comment the Ollama lines above and use these:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=
# LLM_MODEL=gemini-3.5-flash

# Channel: stdio (default), or discord, slack, telegram
CHANNEL=stdio

# Required when CHANNEL=telegram — allowlist only, no pairing
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# TELEGRAM_ERROR_REPORTING=off  # off|error|warn — tee slog into the SAM chat

# Required when CHANNEL=discord — see docs/channels.md
# DISCORD_BOT_TOKEN=
# DISCORD_ALLOWED_USERS=

# Required when CHANNEL=slack — see docs/channels.md
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_ALLOWED_USERS=

# Optional
# PERSONA_DIR=/persona
# DATA_DIR=/data
# MCP_MANIFEST=/etc/george/mcp.toml
# HISTORY_MAX_MESSAGES=200
# HISTORY_MAX_TOKENS=32000   # estimated (chars/4); set 128000 to keep a long verbatim window
# HISTORY_STRIP_FILLERS=true # prompt-only; last 40 msgs verbatim; assistant never stripped; false disables
# TOOL_RESULT_MAX_CHARS=6000
# TOOL_MAX_ITERATIONS=10
# SELF_NOTES_ENABLED=true
# TOOL_SCHEMA_MAX_TOKENS=0
# MEMORY_ENABLED=true
# MEMORY_BACKEND=builtin
# MEMORY_CONSOLIDATE_MINUTES=30
# CRON_ENABLED=true
# CRON_TZ=America/Los_Angeles
# CRON_MAX_JOBS=50
# CRON_TICK_SECONDS=15
# DAILY_PLANNER_AT=07:10
# WATCH_ENABLED=true
# WATCH_MAX=50
# FEEDS_USER_AGENT=feeds-mcp/0.1 (you@example.com)
# X_BEARER_TOKEN=
# GOOGLE_MAPS_API_KEY=
# IMAGE_API_KEY=                    # image-generation-mcp; else LLM_API_KEY
# IMAGE_OUTPUT_DIR=/data/images     # photo_generate writes here; pendant avatar/backdrop source_path
# STREAM_REPLIES=true       # edit-in-place streaming (default)
# SHOW_THINKING=true        # CoT italics → expandable (default; needs STREAM_REPLIES)
# TOOL_TRACE=compact        # full|compact|off (needs STREAM_REPLIES)
# LOG_LEVEL=info

# Required — OpenAI-compatible endpoint (Ollama, llama.cpp, …)
# Local eval model: Qwen3-Coder-30B-A3B at Q4_K_M.
#   ollama pull qwen3-coder:30b-a3b-q4_K_M
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3-coder:30b-a3b-q4_K_M
# LLM_MAX_TOKENS=4096             # completion cap (0 = provider default)
LLM_REASONING_EFFORT=none         # Ollama/Qwen: none so max tokens aren't eaten by CoT

# Optional
# PERSONA_DIR=${HOME}/.config/george           # PERSONA.md + SELF.md
# DATA_DIR=${HOME}/.local/share/george         # george.db
# MCP_MANIFEST=${HOME}/.config/george/mcp.toml
# HISTORY_MAX_MESSAGES=200
# HISTORY_MAX_TOKENS=32000   # estimated (chars/4); set 128000 to keep a long verbatim window
# HISTORY_STRIP_FILLERS=true # prompt-only; last 40 msgs verbatim; assistant never stripped; false disables
# TOOL_RESULT_MAX_CHARS=6000
# TOOL_MAX_ITERATIONS=25     # tool rounds per turn; a final no-tools call then forces a reply
# SELF_NOTES_ENABLED=true    # agent-writable SELF.md + personality distill on /new
#                            # (auto-off when PERSONA_DIR is read-only)
# SHOW_THINKING=true        # CoT italics → expandable (default; needs STREAM_REPLIES)
# TOOL_TRACE=compact        # full|compact|off — tool lines when STREAM_REPLIES=true
# SPINUP_NOTICE_MS=4000     # "working on it" after this much model silence;
#                           # first turn after start posts at once; 0=off
# TOOL_SCHEMA_MAX_TOKENS=0
# WEB_SEARCH_ENABLED=true        # builtin web_search; leftover google-search MCP is omitted
# BRAVE_SEARCH_API_KEY=          # Brave Search (https://api-dashboard.search.brave.com/)
# MEMORY_ENABLED=true
# MEMORY_BACKEND=builtin
# GitHub API for `george tools-fetch` / `tools-plan` with download_tag=latest and
# the eval's real-catalog fetch (make integration-test). Unauthenticated is 60
# lookups/hour per IP; any token (fine-grained, no scopes) lifts it to 5000.
# GITHUB_TOKEN=
# MCP children inherit this process env (see mcp.toml). Not george knobs:
# FEEDS_USER_AGENT=feeds-mcp/0.1 (you@example.com)   # NWS wants a contact UA
# X_BEARER_TOKEN=                                    # twitter-mcp; pay-per-use reads
# GOOGLE_MAPS_API_KEY=                               # google-maps-mcp; place_search / place_resolve / route_eta
# IMAGE_OUTPUT_DIR=/data/images                       # photo_generate writes here; pendant avatar/backdrop source_path
# STREAM_REPLIES=true
# LOG_LEVEL=info

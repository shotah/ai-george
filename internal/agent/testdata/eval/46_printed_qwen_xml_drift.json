{
  "name": "printed_qwen_xml_drift",
  "why": "A spare </function> and a </function_invocation> close do not drop the Qwen3.6 call inside them.",
  "inbound": "What does greet.txt say?",
  "force": ["fs", "shell", "git"],
  "tools_from": ["fs", "shell", "git"],
  "tools": [
    {
      "name": "fs__file_get",
      "result": "hi\n"
    }
  ],
  "script": [
    {
      "content": "<tool_call>\n<function=fs__file_get>\n<parameter=path>\ngreet.txt\n</parameter>\n</function>\n</function>\n</function_invocation>\n</tool_call>"
    }
  ],
  "expect": {
    "round_budget": 3,
    "max_tool_calls": 1,
    "tools_called": [{ "name": "fs__file_get", "args_regex": "greet\\.txt" }],
    "reply_regex": "(?i)\\bhi\\b",
    "reply_not_regex": "<function="
  }
}
